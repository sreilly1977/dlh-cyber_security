{
  "probes": [
    {
      "service": "apache2",
      "type": "http",
      "target": "http://localhost/",
      "timeout": 10
    },
    {
      "service": "mysql",
      "type": "mysql",
      "target": "127.0.0.1:3306",
      "timeout": 10
    },
    {
      "service": "ssh",
      "type": "tcp_connect",
      "target": "127.0.0.1:22",
      "timeout": 10
    }
  ]
}
