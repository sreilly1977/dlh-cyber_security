{
  "installed": true,
  "config_paths": [
    "/etc/apt/apt.conf.d/50unattended-upgrades",
    "/etc/apt/apt.conf.d/20auto-upgrades"
  ],
  "blacklist": [
    {
      "pattern": "linux-image*"
    },
    {
      "pattern": "linux-headers*"
    },
    {
      "pattern": "mysql-server*"
    },
    {
      "pattern": "apache2*"
    },
    {
      "pattern": "libapache2-mod-php*"
    }
  ],
  "timer_state": [
