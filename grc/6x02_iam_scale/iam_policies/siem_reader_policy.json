{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SiemLogReadAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::meddefense-siemlog-prod/*"
    },
    {
      "Sid": "SiemLogBucketListing",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::meddefense-siemlog-prod"
    },
    {
      "Sid": "LambdaLogWrite",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:123456789012:log-group:/aws/lambda/siem-log-reader:*"
    }
  ]
}
