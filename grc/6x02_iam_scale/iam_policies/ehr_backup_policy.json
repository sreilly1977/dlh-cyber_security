{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EhrBackupObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::meddefense-ehr-backup-prod/*"
    },
    {
      "Sid": "EhrBackupBucketListing",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::meddefense-ehr-backup-prod"
    },
    {
      "Sid": "EhrBackupKmsCrypto",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/mrk-abc123def456"
    }
  ]
}
